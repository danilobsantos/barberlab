# Configurações do Banco de Dados PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/barberlab?sslmode=disable"
DATABASE_SSL="false"

# Configurações do NextAuth
NEXT_AUTH_SECRET="substitua_por_um_segredo_com_pelo_menos_32_caracteres"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (opcional para testes locais da interface)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Autenticação por e-mail (link mágico, senha, verificação e recuperação; exige SMTP)
NEXT_PUBLIC_EMAIL_SIGN_IN_ENABLED="false"
EMAIL_SERVER=""
EMAIL_FROM="BarberLab <no-reply@example.com>"

# Assinaturas manuais
SUBSCRIPTION_TRIAL_DAYS="14"
SUBSCRIPTION_GRACE_DAYS="7"
# Periodically POST /api/cron/subscriptions with Authorization: Bearer <secret>
SUBSCRIPTION_CRON_SECRET=""
MANUAL_PAYMENT_INSTRUCTIONS=""

# Modo Demonstração (opcional)
DEMO_MODE="false"
# DEMO_BARBERSHOP_ID=""
# SINGLE_BARBERSHOP_ID=""
